# Local setup: copy this file to .env.local (gitignored), fill in the values,
# then restart `npm run dev`.
#
# Values prefixed with VITE_ are bundled into the public JavaScript, so never put
# secrets in them: no Clerk secret key (sk_...), OTP secret, database URL or
# SMS credentials. Those belong only in backend/.env.

# Base path of the backend API as seen by the browser.
VITE_API_BASE_URL=/api/v1

# Clerk publishable key for staff sign-in. It is public by design and starts with
# pk_test_ (development) or pk_live_ (production). Copy it from the Clerk dashboard:
# Configure > API keys > Publishable key. Use the same Clerk instance as the
# backend's CLERK_SECRET_KEY. Without it, /sign-in and /app show an error; the
# public site and customer quotation pages don't use Clerk and still work.
VITE_CLERK_PUBLISHABLE_KEY=

# Development only: where the Vite dev server forwards /api requests.
# Not bundled into the app (no VITE_ prefix).
API_PROXY_TARGET=http://localhost:8000
