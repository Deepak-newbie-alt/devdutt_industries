# Base path of the backend API as seen by the browser. Values prefixed with VITE_
# are bundled into the public JavaScript, so never put secrets in them.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server forwards /api requests.
# Not bundled into the app (no VITE_ prefix).
API_PROXY_TARGET=http://localhost:8000
