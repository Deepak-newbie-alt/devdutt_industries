// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALESPERSON
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Unit {
  Piece
  Set
  Machine
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum InquiryActivityType {
  CREATED
  CLAIMED
  CUSTOMER_CONTACTED
  NOTE_ADDED
  STATUS_CHANGED
  // OTHER closures go through an admin: request by the salesperson, then the decision.
  CLOSURE_REQUESTED
  CLOSURE_APPROVED
  CLOSURE_REJECTED
}

enum InquiryClosureRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Why a salesperson closed an inquiry by hand; OTHER needs an explanatory note
// and an admin's approval (see InquiryClosureRequest).
enum InquiryClosureReason {
  DUPLICATE
  CUSTOMER_UNREACHABLE
  CUSTOMER_NOT_INTERESTED
  NOT_OUR_PRODUCT
  INVALID_INQUIRY
  OTHER
}

enum QuotationRevisionStatus {
  DRAFT
  SENT
  REVISION_REQUESTED
  SUPERSEDED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CustomerOtpPurpose {
  INQUIRY_SUBMISSION
  QUOTATION_ACCEPT
  QUOTATION_REJECT
  QUOTATION_REQUEST_REVISION
}

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id                      Int                     @id @default(autoincrement())
  clerkId                 String?                 @unique
  name                    String
  email                   String                  @unique @db.VarChar(255)
  phone                   String                  @unique @db.VarChar(20)
  passwordHash            String?
  role                    UserRole
  status                  UserStatus              @default(ACTIVE)
  inquiries               Inquiry[]
  inquiryActivity         InquiryActivity[]
  quotations              Quotation[]
  revisions               QuotationRevision[]
  orderActivities         OrderActivity[]
  closureRequestsMade     InquiryClosureRequest[] @relation("ClosureRequestsMade")
  closureRequestsReviewed InquiryClosureRequest[] @relation("ClosureRequestsReviewed")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@map("users")
}

model Category {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  slug         String         @unique @db.VarChar(120)
  description  String?        @db.VarChar(500)
  displayOrder Int            @default(0)
  status       CategoryStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  products     Product[]

  @@map("categories")
}

model Product {
  id                   Int              @id @default(autoincrement())
  name                 String           @db.VarChar(200)
  slug                 String           @unique @db.VarChar(220)
  description          String           @db.VarChar(1000)
  price                Decimal          @db.Decimal(12, 2)
  unit                 Unit
  minimumOrderQuantity Int              @default(1)
  specifications       Json             @default("{}")
  status               ProductStatus    @default(ACTIVE)
  categoryId           Int
  category             Category         @relation(fields: [categoryId], references: [id])
  images               ProductImage[]
  videos               ProductVideo[]
  brochure             ProductBrochure?
  inquiries            Inquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("productimages")
}

model ProductVideo {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  youtubeUrl   String
  title        String   @db.VarChar(200)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("productvideos")
}

model ProductBrochure {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productbrochures")
}

model Inquiry {
  id              Int                     @id @default(autoincrement())
  productId       Int
  product         Product                 @relation(fields: [productId], references: [id])
  salespersonId   Int?
  salesperson     User?                   @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  requirement     String                  @db.VarChar(1200)
  phoneNumber     String
  status          InquiryStatus           @default(OPEN)
  inquiryActivity InquiryActivity[]
  quotation       Quotation?
  closureRequests InquiryClosureRequest[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("inquiries")
}

// Audit record of an OTHER closure request and the admin's decision. Restrict keeps it from
// being removed by deleting the inquiry or either user.
model InquiryClosureRequest {
  id            Int                         @id @default(autoincrement())
  inquiryId     Int
  inquiry       Inquiry                     @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  requestedById Int
  requestedBy   User                        @relation("ClosureRequestsMade", fields: [requestedById], references: [id], onDelete: Restrict)
  note          String                      @db.VarChar(350)
  status        InquiryClosureRequestStatus @default(PENDING)
  reviewedById  Int?
  reviewedBy    User?                       @relation("ClosureRequestsReviewed", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNote    String?                     @db.VarChar(350)
  reviewedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([status, createdAt])
  @@index([inquiryId, status])
  @@map("inquiryclosurerequests")
}

model InquiryActivity {
  id            Int                   @id @default(autoincrement())
  inquiryId     Int
  inquiry       Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  salespersonId Int?
  salesperson   User?                 @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  activityType  InquiryActivityType
  // Set only on manual closures.
  closureReason InquiryClosureReason?
  note          String?               @db.VarChar(350)
  createdAt     DateTime              @default(now())

  @@map("inquiryactivities")
}

model Quotation {
  id              Int     @id @default(autoincrement())
  inquiryId       Int     @unique
  inquiry         Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  salespersonId   Int
  salesperson     User    @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  quotationNumber String  @unique @db.VarChar(50)

  revisions QuotationRevision[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("quotations")
}

model QuotationRevision {
  id                      Int                     @id @default(autoincrement())
  quotationId             Int
  quotation               Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber          Int
  quotationRevisionStatus QuotationRevisionStatus @default(DRAFT)

  //Buyer snapshot
  buyerName    String  @db.VarChar(50)
  companyName  String? @db.VarChar(50)
  address      String
  gstNumber    String  @db.VarChar(50)
  mobileNumber String  @db.VarChar(50)
  email        String? @db.VarChar(255)

  //Machine snapshot
  productName           String @db.VarChar(200)
  machineSpecifications Json

  terms                   Json
  validUntil              DateTime @db.Date
  // SHA-256 of the customer response-link token; the token itself is never stored.
  customerAccessTokenHash String?  @unique @db.Char(64)
  salespersonId           Int
  salesperson             User     @relation(fields: [salespersonId], references: [id], onDelete: Restrict)

  items QuotationItem[]

  taxableAmount Decimal  @db.Decimal(12, 2)
  cgstRate      Decimal? @db.Decimal(5, 2)
  cgstAmount    Decimal? @db.Decimal(12, 2)

  sgstRate   Decimal? @db.Decimal(5, 2)
  sgstAmount Decimal? @db.Decimal(12, 2)

  igstRate   Decimal? @db.Decimal(5, 2)
  igstAmount Decimal? @db.Decimal(12, 2)

  grandTotal Decimal @db.Decimal(12, 2)
  currency   String  @default("INR") @db.VarChar(3)

  order Order?

  document QuotationDocument?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, revisionNumber])
  @@map("quotationrevisions")
}

// PDF issued when a revision is sent. Written once, never updated.
model QuotationDocument {
  id                  Int               @id @default(autoincrement())
  quotationRevisionId Int               @unique
  quotationRevision   QuotationRevision @relation(fields: [quotationRevisionId], references: [id], onDelete: Restrict)

  fileName  String @db.VarChar(100)
  content   Bytes
  sha256    String @db.Char(64)
  sizeBytes Int

  createdAt DateTime @default(now())

  @@map("quotationdocuments")
}

model QuotationItem {
  id                  Int               @id @default(autoincrement())
  quotationRevisionId Int
  quotationRevision   QuotationRevision @relation(fields: [quotationRevisionId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(100)
  description  String?
  quantity     Int     @default(1)
  unit         Unit
  unitPrice    Decimal @db.Decimal(12, 2)
  amount       Decimal @db.Decimal(12, 2)
  displayOrder Int     @default(0)

  @@index([quotationRevisionId])
  @@map("quotationitems")
}

model QuotationNumberCounter {
  year       Int @id
  lastNumber Int

  @@map("quotationnumbercounters")
}

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique @db.VarChar(50)

  quotationRevisionId Int               @unique
  quotationRevision   QuotationRevision @relation(fields: [quotationRevisionId], references: [id], onDelete: Restrict)

  status OrderStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  activities OrderActivity[]

  @@map("orders")
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100)
  description String
  quantity    Int
  unit        Unit
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  displayOrder Int @default(0)

  @@map("orderitems")
}

model OrderNumberCounter {
  year       Int @id
  lastNumber Int

  @@map("ordernumbercounters")
}

enum OrderActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
}

model OrderActivity {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  activityType   OrderActivityType
  previousStatus OrderStatus?
  newStatus      OrderStatus?
  note           String?
  createdAt      DateTime          @default(now())

  @@index([orderId, createdAt])
  @@map("orderactivities")
}

model CompanySettings {
  id Int @id @default(1)

  companyName String @db.VarChar(200)

  addressLine1 String  @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  postalCode   String  @db.VarChar(20)
  country      String  @default("India") @db.VarChar(100)

  phone   String  @db.VarChar(20)
  email   String? @db.VarChar(255)
  website String? @db.VarChar(255)

  gstin   String? @db.VarChar(15)
  logoUrl String? @db.VarChar(500)

  defaultTermsAndConditions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companysettings")
}

// One OTP sent to a customer. Bound to a purpose, a target phone and (for quotations) a revision.
// Only the HMAC of the code is stored.
model CustomerOtpChallenge {
  id      String             @id @default(uuid()) @db.Uuid
  purpose CustomerOtpPurpose

  // Null for placeholder challenges created for ineligible or unknown quotations.
  phoneNumber String? @db.VarChar(15)
  // Quotation revision id for quotation purposes; null for inquiry submission. No FK by design.
  resourceId  Int?

  codeHash      String    @db.Char(64)
  attempts      Int       @default(0)
  // Set only after the SMS is delivered; unsent challenges are never usable.
  sentAt        DateTime?
  expiresAt     DateTime
  consumedAt    DateTime?
  // Set when the quotation link is reissued; revoked codes don't hold the resend cooldown.
  revokedAt     DateTime?
  requestIpHash String    @db.Char(64)

  createdAt DateTime @default(now())

  @@index([purpose, phoneNumber, createdAt])
  @@index([resourceId, createdAt])
  @@index([requestIpHash, createdAt])
  @@map("customerotpchallenges")
}
