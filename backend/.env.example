PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devdutt_db"
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Customer OTP. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# "console" logs codes (development only; refused when NODE_ENV=production).
# "msg91" sends through the MSG91 Flow API with an approved OTP template.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Template variable that holds the code, as named in the MSG91 template.
MSG91_OTP_TEMPLATE_VARIABLE=

# Proxies trusted for X-Forwarded-For (used for per-IP OTP limits).
# Leave empty locally. In production use the number of proxy hops in front of
# the app (e.g. 1 behind a single load balancer) or the proxies' addresses/CIDRs.
# "true" is rejected.
TRUST_PROXY=

# Customer quotation page. Response links are <this URL>#token=<token>.
CUSTOMER_QUOTATION_URL=http://localhost:5173/quotation
